# Copiază în `.env.local` și completează cu valorile din proiectul Supabase.
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cheie privată — NU o expune niciodată în browser.
# Folosită server-side pentru: setările de email (tabel fără policy RLS),
# gestionarea utilizatorilor din Auth, jurnalul de audit și încărcarea
# fotografiilor în Storage.
SUPABASE_SERVICE_ROLE_KEY=

# Conexiune directă la Postgres — NU e folosită de aplicație, doar de
# `scripts/db-migrate.mjs`, pentru că Supabase nu expune DDL prin API.
# Supabase → Connect → Session pooler (nu Transaction pooler).
SUPABASE_DB_URL=
